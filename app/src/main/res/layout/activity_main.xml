<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Planear recorridos con Google Maps"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- ========== PARTE A: RECOLECTOR DE ENCOMIENDAS ========== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A. Encomiendas del día (recolector)"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEncomiendas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cargando encomiendas..." />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="0"
            android:onClick="onVerEncomienda"
            android:text="Ver ubicación encomienda 1" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="1"
            android:onClick="onVerEncomienda"
            android:text="Ver ubicación encomienda 2" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="2"
            android:onClick="onVerEncomienda"
            android:text="Ver ubicación encomienda 3" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="3"
            android:onClick="onVerEncomienda"
            android:text="Ver ubicación encomienda 4" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:onClick="onPlanearRuta"
            android:text="Planear ruta del día (más eficiente)" />

        <TextView
            android:id="@+id/tvOrdenRuta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Orden sugerido: (presiona Planear ruta)" />

        <!-- ========== PARTE B: TUTORÍAS ========== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="B. Tutorías: docente más cercano"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDocentes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cargando docentes..." />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onBuscarDocente"
            android:text="Buscar docente más cercano" />

        <TextView
            android:id="@+id/tvDocenteCercano"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Docente más cercano: (presiona Buscar)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Alternativas de ruta hacia el docente:" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="driving"
            android:onClick="onRutaDocente"
            android:text="Ruta en carro" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="walking"
            android:onClick="onRutaDocente"
            android:text="Ruta caminando" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="bicycling"
            android:onClick="onRutaDocente"
            android:text="Ruta en bicicleta" />

    </LinearLayout>
</ScrollView>